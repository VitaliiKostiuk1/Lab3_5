<?xml version="1.0" encoding="utf-8"?>
<!-- Налаштування збору покриття коду (coverlet).
     Рахуємо покриття лише для BLL і DAL — саме їх перевіряють модульні тести. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[Lab3_5.BLL]*,[Lab3_5.DAL]*</Include>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
